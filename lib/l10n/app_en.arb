  "ppLastUpdated": "Last updated: January 2025",
  "@ppLastUpdated": {
    "description": "Last updated date for privacy policy"
  },
  "ppIntroduction": "Atelia operates the Atelia mobile application and web platform.\n\nThis Privacy Policy explains how we collect, use, disclose, and protect your information when you use our Service.\n\nBy accessing or using Atelia, you agree to the collection and use of information in accordance with this Privacy Policy.",
  "@ppIntroduction": {
    "description": "Introduction text for privacy policy"
  },
  "ppInformationWeCollect": "1. Information We Collect",
  "@ppInformationWeCollect": {
    "description": "Section title: Information We Collect"
  },
  "ppInformationWeCollectContent": "a. Personal Information\n\nWhen you create an account or use our Service, we may collect:\n• Name or username\n• Email address\n• Payment and billing information (processed securely by third-party providers)\n• Account preferences\n\nb. Usage Data\n\nWe automatically collect information such as:\n• Device type, operating system, and app version\n• IP address and approximate location\n• Pages/screens viewed and features used\n• Time and date of usage\n\nc. User Content\n\nWhen you use Atelia, you may provide:\n• Design prompts and inputs\n• Generated designs and techpacks\n• Files or content uploaded to the platform\n\nWe do not claim ownership over your content.",
  "@ppInformationWeCollectContent": {
    "description": "Content for Information We Collect section"
  },
  "ppHowWeUseYourInformation": "2. How We Use Your Information",
  "@ppHowWeUseYourInformation": {
    "description": "Section title: How We Use Your Information"
  },
  "ppHowWeUseYourInformationContent": "We use your data to:\n• Provide and operate the Service\n• Generate AI-based designs and techpacks\n• Manage subscriptions and payments\n• Improve product performance and user experience\n• Communicate updates, support messages, and important notices\n• Detect fraud, abuse, or misuse of the Service",
  "@ppHowWeUseYourInformationContent": {
    "description": "Content for How We Use Your Information section"
  },
  "ppAIAndThirdPartyServices": "3. AI & Third-Party Services",
  "@ppAIAndThirdPartyServices": {
    "description": "Section title: AI & Third-Party Services"
  },
  "ppAIAndThirdPartyServicesContent": "Atelia uses third-party services to operate:\n• AI model providers\n• Cloud infrastructure and hosting\n• Analytics and performance monitoring\n• Payment processors\n\nYour data may be processed by these providers only to deliver the Service and in accordance with applicable data protection laws.",
  "@ppAIAndThirdPartyServicesContent": {
    "description": "Content for AI & Third-Party Services section"
  },
  "ppDataRetention": "4. Data Retention",
  "@ppDataRetention": {
    "description": "Section title: Data Retention"
  },
  "ppDataRetentionContent": "We retain personal data only for as long as necessary to:\n• Provide the Service\n• Comply with legal obligations\n• Resolve disputes\n• Enforce agreements\n\nYou may request deletion of your account and data at any time.",
  "@ppDataRetentionContent": {
    "description": "Content for Data Retention section"
  },
  "ppDataSharingAndDisclosure": "5. Data Sharing & Disclosure",
  "@ppDataSharingAndDisclosure": {
    "description": "Section title: Data Sharing & Disclosure"
  },
  "ppDataSharingAndDisclosureContent": "We do not sell your personal data.\n\nWe may share data only:\n• With trusted service providers under confidentiality agreements\n• To comply with legal obligations\n• To protect our rights, users, or platform security",
  "@ppDataSharingAndDisclosureContent": {
    "description": "Content for Data Sharing & Disclosure section"
  },
  "ppSecurity": "6. Security",
  "@ppSecurity": {
    "description": "Section title: Security"
  },
  "ppSecurityContent": "We implement industry-standard security measures to protect your data.\n\nHowever, no method of transmission or storage is 100% secure.",
  "@ppSecurityContent": {
    "description": "Content for Security section"
  },
  "ppYourRights": "7. Your Rights",
  "@ppYourRights": {
    "description": "Section title: Your Rights"
  },
  "ppYourRightsContent": "Depending on your location, you may have the right to:\n• Access your personal data\n• Correct inaccurate data\n• Request deletion of your data\n• Object to or restrict processing\n\nTo exercise these rights, contact us at:\nateliadesign.contact@gmail.com",
  "@ppYourRightsContent": {
    "description": "Content for Your Rights section"
  },
  "ppChildrensPrivacy": "8. Children's Privacy",
  "@ppChildrensPrivacy": {
    "description": "Section title: Children's Privacy"
  },
  "ppChildrensPrivacyContent": "Atelia is not intended for users under the age of 16.\n\nWe do not knowingly collect personal data from children under 16. If we become aware of such data, we will delete it immediately.",
  "@ppChildrensPrivacyContent": {
    "description": "Content for Children's Privacy section"
  },
  "ppInternationalDataTransfers": "9. International Data Transfers",
  "@ppInternationalDataTransfers": {
    "description": "Section title: International Data Transfers"
  },
  "ppInternationalDataTransfersContent": "Your information may be transferred and stored on servers located outside your country.\n\nBy using Atelia, you consent to such transfers.",
  "@ppInternationalDataTransfersContent": {
    "description": "Content for International Data Transfers section"
  },
  "ppChangesToThisPrivacyPolicy": "10. Changes to This Privacy Policy",
  "@ppChangesToThisPrivacyPolicy": {
    "description": "Section title: Changes to This Privacy Policy"
  },
  "ppChangesToThisPrivacyPolicyContent": "We may update this Privacy Policy from time to time. Any changes will be posted within the app or on our website.\n\nContinued use of the Service after changes constitutes acceptance.",
  "@ppChangesToThisPrivacyPolicyContent": {
    "description": "Content for Changes to This Privacy Policy section"
  },
  "ppContactUs": "11. Contact Us",
  "@ppContactUs": {
    "description": "Section title: Contact Us"
  },
  "ppContactUsContent": "If you have questions about this Privacy Policy, contact us:\n\nEmail: ateliadesign.contact@gmail.com",
  "@ppContactUsContent": {
    "description": "Content for Contact Us section"
  },

